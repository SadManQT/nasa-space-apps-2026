; Engine configuration file.
; Godot 4.7.2 stable. Renderer: Forward+ (see PRODUCTION_HANDBOOK.md section 3).

config_version=5

[application]

config/name="Last Light Academy"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"

[physics]

common/physics_interpolation=true

[importer_defaults]

scene={
"gltf/embedded_image_handling": 2
}

[input]

move_forward={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}

move_back={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}

move_left={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}

move_right={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}

camera_left={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}

camera_right={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}

camera_up={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}

camera_down={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}

run={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

sprint={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":4194326), Object(InputEventJoypadButton,"button_index":7)]
}

interact={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":0)]
}
