; LOC-11 (M3-8R). The approved M3-8A pieces are authored in resources/campaign/rooms/LOC-11.json ("assembly": "exterior_kit");
; PiecePreload makes their GLBs (both LODs) and VH_Rover_Lit dependencies of this scene, so a threaded room load
; decodes them off the main thread before the room is built.
[node name="RelayRoad" type="Node3D"]
script = ExtResource("1_room")
room_id = "LOC-11"

[node name="PiecePreload" type="ResourcePreloader" parent="."]
resources = [PackedStringArray("EN_RelayRoad_Repeater_LOD0", "EN_RelayRoad_Repeater_LOD1", "EN_MalapertSummit_TetherAnchor_LOD0", "EN_MalapertSummit_TetherAnchor_LOD1", "EN_RelayRoad_SlopeSign_LOD0", "EN_RelayRoad_SlopeSign_LOD1", "EN_RelayRoad_TurnbackBarrier_LOD0", "EN_RelayRoad_TurnbackBarrier_LOD1", "EN_MalapertSummit_PerimeterMarker_LOD0", "EN_MalapertSummit_PerimeterMarker_LOD1", "EN_RelayRoad_GuideLight_LOD0", "EN_RelayRoad_GuideLight_LOD1", "VH_Rover_Lit", "EN_RelayRoad_BatteryModule_LOD0"), [ExtResource("2_p2"), ExtResource("3_p3"), ExtResource("4_p4"), ExtResource("5_p5"), ExtResource("6_p6"), ExtResource("7_p7"), ExtResource("8_p8"), ExtResource("9_p9"), ExtResource("10_p10"), ExtResource("11_p11"), ExtResource("12_p12"), ExtResource("13_p13"), ExtResource("14_p14"), ExtResource("15_p15")]]
