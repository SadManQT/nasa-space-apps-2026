*.Trashes

# Editor & environment (.env holds API keys such as NASA_API_KEY; never commit it)
.env
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Python cache & logs
**/__pycache__/
*.py[cod]
*.log

# Staging area for AI-generated models (raw downloads, reuse sources, pre-Godot finals).
# Large and regenerable; the committed game copies live in game/assets/.
production/models/

# Cutscene mixes (rebuilt by compose_cutscene.py)
production/cutscenes/v7/*.wav

# Outdated cutscenes archive & masters/review if generated locally
production/cutscenes/masters/
production/cutscenes/review/
archive/

# Godot generated cache (.import files are committed)
.godot/
game/.godot/

# OpenCode local session state and Windows shell artifacts
.opencode/
nul
NUL

# Claude Code Game Studios local state
.claude/settings.local.json
.claude/agent-memory/
.claude/worktrees/
CLAUDE.local.md
project.local.yaml
production/session-logs/
production/session-state/
docs/consistency-failures.md

# Reproducible release candidates and web staging (M1-20)
/builds/
