+func _comparable_snapshot(snapshot: Dictionary) -> Dictionary:
+	var copy := snapshot.duplicate(true)
+	var resume: Variant = copy.get("presentation_resume")
+	if resume is Dictionary:
+		var metadata: Variant = (resume as Dictionary).get("slot_metadata")
+		if metadata is Dictionary:
+			(metadata as Dictionary).erase("saved_at_utc")
+	return copy
+
+func _test_snapshot_comparison(snapshot: Dictionary) -> void:
+	var original := snapshot.duplicate(true)
+	var timestamp_only := snapshot.duplicate(true)
+	timestamp_only.presentation_resume.slot_metadata.saved_at_utc = "2099-01-01 00:00:00 UTC"
+	_check(_comparable_snapshot(timestamp_only) == _comparable_snapshot(snapshot), "regenerated save timestamps do not change the gameplay comparison")
+	_check(snapshot == original, "snapshot comparison leaves the source and its stored metadata intact")
+	var gameplay_change := snapshot.duplicate(true)
+	gameplay_change["scenario_datetime"] = String(snapshot.get("scenario_datetime", "")) + " changed"
+	_check(_comparable_snapshot(gameplay_change) != _comparable_snapshot(snapshot), "actual scenario-clock mutations remain detectable")
